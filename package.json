{
  "name": "taut",
  "version": "3.0.0",
  "description": "Client mod for Slack",
  "license": "GPL-3.0-or-later",
  "private": true,
  "author": {
    "name": "Jeremy Woolley",
    "email": "taut@jeremywoolley.com",
    "url": "https://jeremywoolley.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremy46231/taut"
  },
  "homepage": "https://github.com/jeremy46231/taut",
  "bugs": "https://github.com/jeremy46231/taut/issues",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:icons": "node scripts/icons.ts",
    "build:natives": "node scripts/natives.ts",
    "build:user-plugin": "node scripts/userPlugin.ts",
    "dev": "node scripts/dev.ts",
    "desktop:dev": "node scripts/desktop.ts",
    "repo": "node scripts/repo.ts",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && tsc -p server",
    "readme": "node scripts/readme.ts",
    "fix": "biome check --write . && prettier --write \"**/*.md\" && tsc --noEmit",
    "server:dev": "node scripts/build.ts taut extension userscript versions server && wrangler dev --config server/wrangler.jsonc --var \"VERSIONS:$(cat dist/server-versions.json)\"",
    "server:deploy": "wrangler deploy --config server/wrangler.jsonc --var \"VERSIONS:$(cat dist/server-versions.json)\""
  },
  "keywords": ["taut", "slack", "mod", "patcher"],
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^4.20260609.1",
    "@monaco-editor/loader": "^1.7.0",
    "@types/chrome": "^0.1.43",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "44.3.0",
    "electron-builder": "^26.0.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.27.0",
    "fflate": "^0.8.3",
    "monaco-editor": "^0.55.1",
    "prettier": "^3.9.9",
    "sharp": "^0.34.5",
    "tar-stream": "^3.2.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.98.0",
    "xz-decompress": "^0.2.3"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
