{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taut-server",
  "compatibility_date": "2026-06-09",
  "main": "src/index.ts",
  // only served on taut.jer.app, and workers.dev makes wrangler read an account setting the CI token can't
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist/server",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taut",
      "database_id": "dd18750f-d463-4690-a6c5-a807ba5819c1",
      "migrations_dir": "migrations"
    }
  ]
}
